
pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code ready'
            }
        }

        stage('Build and Test') {
            steps {
                bat 'mvnw.cmd clean verify'
            }
        }

        stage('Package') {
            steps {
                archiveArtifacts(
                    artifacts: 'target/*.jar',
                    fingerprint: true
                )
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Spring Boot build and tests passed!'
        }
        failure {
            echo 'FAILED: Check the Jenkins Console Output.'
        }
    }
}
