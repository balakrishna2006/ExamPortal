pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code ready'
            }
        }

        stage('Build and Test') {
            steps {
                dir('demo') {
                    bat 'mvnw.cmd clean verify'
                }
            }
        }

        stage('Package') {
            steps {
                archiveArtifacts artifacts: 'demo/target/*.jar',
                                 fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'ExamPortal CI pipeline succeeded!'
        }
        failure {
            echo 'FAILED: Check the Jenkins Console Output.'
        }
    }
}